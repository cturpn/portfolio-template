# Copy to .env and fill in. Never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contact form (optional; without it the form tells visitors to email you directly)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Site assistant (optional; also set CHAT["enabled"] = True in config.py)
GROQ_API_KEY=
# CHAT_MODEL=           # try this model before the ones listed in config.py

# Preview another theme without editing config.py
# PORTFOLIO_THEME=editorial

# Set to 0 when not running behind a hosting proxy
TRUST_PROXY=1
